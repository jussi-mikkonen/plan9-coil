# the wheel scrolls three lines per step without moving the cursor; the next key reveals it again
size 6 20
file w.c "l01\nl02\nl03\nl04\nl05\nl06\nl07\nl08\nl09\nl10\nl11\nl12\nl13\nl14\nl15\nl16\nl17\nl18\nl19\nl20\nl21\nl22\nl23\nl24\nl25\nl26\nl27\nl28\nl29\nl30\n"
open w.c
wheel 1
dump screen
dump sel
wheel 1
dump sel
wheel -1
wheel -1
wheel -1
dump screen
wheel 1
keys "j"
dump screen
dump sel
