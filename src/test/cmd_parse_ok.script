# well-formed lines and their canonical form
parse "x/foo/ c/bar/"
parse "%x/a/ g/b/ d"
parse ",y/,/ i/X/"
parse "x"
parse "x/re/"
parse "v/re/ a/t/"
parse "  %  x  /a/  v  /b/  c  /t/  "
parse "x g/foo/ d"
parse "xx d"
parse "%"
parse ""
parse "x/a"
parse "y d"
parse "%x/.*\\n/ g/foo/ d"
parse "x/a/ x/b/ x/c/ x/d/ x/e/ x/f/ x/g/ x/h/ d"
