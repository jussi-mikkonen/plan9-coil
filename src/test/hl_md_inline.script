# markdown line lexer: headings, emphasis, code spans, links, list markers
lang markdown
lex "# Title"
lex "####### seven"
lex "  ## two"
lex "#nospace"
lex "a *em* b"
lex "snake_case_name"
lex "a * b * c"
lex "**bold** and __b__"
lex "_em_ and *x*"
lex "use `x()` here"
lex "``a ` b``"
lex "`open"
lex "[coil](http://x)"
lex "[no](paren"
lex "<http://9front.org>"
lex "<b>not</b>"
lex "- item"
lex "* item"
lex "12. item"
lex "3) item"
lex "> quote"
lex "-no"
lex "  - *x* `y`"
lex "\\*not em\\*"
lex "a\xff\x00 *b\xff*"
lex ""
