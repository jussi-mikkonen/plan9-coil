# C line lexer: one legend letter per byte, then the state carried out (hex)
lang c
lex "int x = 42;"
lex "static uchar *p = nil;"
lex "u32int a; Rune r; Foo f;"
lex "x = 0x1F + 1.5e-3 + .5;"
lex "a1 = b2;"
lex "s = \"a\\\"b\"; c = '\\'';"
lex "\"unterminated"
lex "x; // note"
lex "x /* a */ y"
lex "a /* open"
lex "#include <u.h>"
lex "  #define X 1 /* c */"
lex "#define Y \\"
lex "a\xff\x00 b\xffint"
lex "printf(\"%d\", f(x));"
lex "for(;;) return sizeof(vlong);"
lex ""
